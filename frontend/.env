    # Copy thành .env và điền giá trị thật, KHÔNG commit .env lên git.

    # 'local'    -> dùng localStorage (offline, mặc định, không cần backend)
    # 'supabase' -> đồng bộ dữ liệu qua Supabase (xem backend/README.md)
    VITE_STORAGE_MODE=supabase

    # Lấy tại Supabase Dashboard -> Project Settings -> API
    # Chỉ cần khi VITE_STORAGE_MODE=supabase
    VITE_SUPABASE_URL=https://rslhoxeagpwfckrentwm.supabase.co
    VITE_SUPABASE_ANON_KEY=sb_publishable_BdDksEJJfXE64QTHNvnXCA_pdVlcuUg
    -- Cập nhật mật khẩu admin về 'admin' cho khớp với frontend/local
    UPDATE public.user_accounts
    SET password = 'admin'
    WHERE username = 'admin';

    -- Đảm bảo trạng thái tài khoản đang kích hoạt
    UPDATE public.user_accounts
    SET is_active = true
    WHERE username = 'admin';